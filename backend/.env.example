# Copy to .env and fill in real values
PORT=3001

# IMPORTANT: Generate a strong secret — run: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-secret

# Generate hash for your admin password — run: node -e "const b=require('bcryptjs');console.log(b.hashSync('YOUR_PASSWORD',10))"
ADMIN_PASSWORD_HASH=$2b$10$examplehashherereplaceme

# Comma-separated allowed frontend origins (no trailing slash)
ALLOWED_ORIGINS=https://YOUR_GITHUB_USERNAME.github.io,http://localhost:5173

# Where to store uploads (absolute path recommended on VPS)
UPLOAD_DIR=/var/www/media-vault/uploads

# SQLite database path
DB_PATH=/var/www/media-vault/media.db
